{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "format:code": "eslint --fix .",
    "test": "vitest run --configLoader runner",
    "db:generate": "drizzle-kit generate --config=drizzle.waitlist.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.waitlist.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "resend": "^4.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "eslint": "^9.29.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
